{
  "manifest_version": 3,
  "name": "Twitch Cropper",
  "version": "1.0.1",
  "description": "Crop and zoom any Twitch stream, VOD or clip to just the part you want, loop a segment of a VOD or clip, unload chat, and pop the crop out into its own window.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{af2b2570-4f93-4ee0-a9bf-86aaa5c0da49}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://twitch.tv/*",
    "https://*.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitch.tv/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "src/core.js",
        "src/chat.js",
        "src/loop.js",
        "src/panel.js",
        "src/main.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "Twitch Cropper",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Show or hide the Twitch Cropper panel"
    },
    "toggle-crop": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Turn Twitch Cropper on or off"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
